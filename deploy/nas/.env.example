# Copy to deploy/nas/.env and fill in. Never commit the real .env (it is git-ignored).

# Cloudflare Tunnel token: Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Docker command (the long value after --token).
CLOUDFLARE_TUNNEL_TOKEN=<paste-tunnel-token-here>

# The public hostname you map to http://wobble:3000 in the tunnel (for your reference; the app needs wss://<this>/ws).
PUBLIC_HOSTNAME=play.<your-domain>

# 1 = online play needs a signed-in account (recommended). 0 = anyone can connect.
REQUIRE_LOGIN=1

# cloudflare (behind the tunnel) | 1 (one generic reverse proxy) | 0 (no proxy: use the socket address)
TRUST_PROXY=cloudflare

# Host port for LAN testing.
WOBBLE_HOST_PORT=3000

# Optional Upstash Redis for accounts (leave empty to use the volume).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
