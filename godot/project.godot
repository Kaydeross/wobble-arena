; Wobble Arena (Godot 4) - native iOS client. Cross-plays with the web game through the room protocol in docs/PROTOCOL.md.
config_version=5

[application]
config/name="Wobble Arena"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/version="0.1.0"
config/icon="res://icon.png"
; Launch: the two-line logo (ui/brand/launch_logo.png, rendered by tools/shoot-godot-brand.sh) on the panel teal,
; matching the iOS launch storyboard (export_presets.cfg storyboard/*).
boot_splash/bg_color=Color(0.0627, 0.1686, 0.2078, 1)
boot_splash/show_image=true
boot_splash/image="res://ui/brand/launch_logo.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

Tier="*res://autoload/tier.gd"
Content="*res://autoload/content.gd"
Settings="*res://autoload/settings.gd"
FpsOverlay="*res://ui/fps_overlay.gd"
Sfx="*res://autoload/audio.gd"

[audio]

; iOS: Solo Ambient = honours the silent switch and does not mix with other apps' audio.
general/ios/session_category=5
general/ios/mix_with_others=false

[display]
window/size/viewport_width=1170
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor landscape (1 was portrait, which iOS then locked the app to).
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme.tres"

[rendering]
; Render tiers (autoload Tier): PC = Forward+, iOS/Android = Mobile, web = Compatibility.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
; iOS export refuses to run (with an empty error list) unless ETC2/ASTC textures are imported.
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
