{
  "name": "wobble-arena-server",
  "version": "1.0.0",
  "description": "Room list and message relay for Wobble Arena",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "content": "node tools/export-content.js && node tools/sync-shared.js", "sync": "node tools/sync-shared.js",
    "test:godot-audio": "node tools/test-audio.js", "sfx": "node tools/render-sfx.js", "test:browser": "node tools/test-browser.js", "test:dynamics": "node tools/test-dynamics.js", "test:dyn": "node tools/test-dyn-browser.js", "test:godot-dynamics": "node tools/test-godot-dynamics.js", "test:touch": "node tools/test-touch.js", "shots": "node tools/shoot-maps.js", "check:maps": "node tools/check-maps.js", "test:godot": "node tools/test-godot.js", "test:godot-physics": "node tools/test-physics.js", "content:check": "node tools/export-content.js --check && node tools/sync-shared.js --check", "test:godot-world": "node tools/test-world.js", "test:godot-spring": "node tools/test-spring.js", "test:godot-wobbler": "node tools/test-wobbler.js", "test:godot-camera": "node tools/test-camera.js", "test:godot-ragdoll": "node tools/test-ragdoll.js", "test:godot-combat": "node tools/test-combat.js", "test:godot-integration": "node tools/test-integration.js", "test:godot-weapons": "node tools/test-weapon-models.js", "test:godot-netguest": "node tools/test-net-guest.js", "test:crossplay-web": "node tools/crossplay-web.js", "test:godot-ui": "node tools/test-ui.js", "test:godot-construction": "node tools/test-construction.js", "test:godot-modes": "node tools/test-modes.js", "test:godot-damage": "node tools/test-damage.js", "test:godot-bots": "node tools/test-bots.js", "test:godot-maps": "node tools/test-godot-maps.js", "test:godot-gfx": "node tools/test-gfx.js", "map-decor": "node tools/export-map-decor.js",
    "test": "node tools/export-content.js --check && node tools/sync-shared.js --check && node tools/check-maps.js --quiet && node tools/test-server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
